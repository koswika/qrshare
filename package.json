{
  "name": "qrshare-cli",
  "version": "1.0.0",
  "description": "A tool to share files over local Wi-Fi using QR codes",
  "main": "dist/index.js",
  "bin": {
    "qrshare": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "qr",
    "share",
    "files",
    "local-network",
    "cli"
  ],
  "author": "koswika",
  "license": "MIT",
  "devDependencies": {
    "@types/chalk": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ora": "^3.2.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "ora": "^5.4.1"
  }
}